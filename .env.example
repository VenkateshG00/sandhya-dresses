# This file documents required environment variables.
# DO NOT put real secrets here. Set secrets via: wrangler secret put SECRET_NAME

# ── Wrangler Secrets (set with: wrangler secret put KEY) ──────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ADMIN_PASSWORD_HASH=<bcrypt hash of your admin password>
# SESSION_SECRET=<random 64-character hex string>

# ── wrangler.toml [vars] (non-secret, committed) ──────────────────────────────
ENVIRONMENT=development
SITE_URL=http://localhost:5173

# ── Local dev only (.dev.vars — never commit this file) ───────────────────────
# Create .dev.vars with real values for local wrangler dev:
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ADMIN_PASSWORD_HASH=<bcrypt hash>
# SESSION_SECRET=<64-char hex>
